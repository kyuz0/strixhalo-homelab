# GitHub repo hosting the wiki: `user/repo` or `user/repo/branch`.
# Raw attachment links and GitHub page links are generated from it.
GH_REPO=deseven/strixhalo-homelab

# Generate clean internal links. When 'true', each page is emitted as
# `key/index.html` and linked as `key/` (e.g.
# `Hardware/PCs/Abee_AI_Station/`), which works on GitHub Pages and other
# static hosts without rewrite rules. The wiki entry point is always `index.html`.
# Anything other than 'true' keeps `.html` in the links.
#CLEAN_URLS=false
